# ============================================
# MONITORING PLATFORM - Environment Variables
# ============================================
# Copy to .env and adjust as needed
# NEVER commit .env to Git!
# ============================================

# PostgreSQL Configuration
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_secret_2024

# IoT Monitoring Database
MONITORING_DB=monitoring

# Timezone (used by PostgreSQL, Python, and Zabbix)
TZ=Africa/Cairo

# Device discovery window (days) for Zabbix provisioning
DEVICE_DISCOVERY_DAYS=90

# Zabbix Host Provisioning Defaults
ZABBIX_DEFAULT_GROUPS=IoT Sensors
ZABBIX_DEFAULT_TEMPLATES=
ZABBIX_DEFAULT_INTERFACE_TYPE=1
ZABBIX_DEFAULT_PORT=10050
ZABBIX_AUTO_PROVISION_HOSTS=true